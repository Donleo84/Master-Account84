# Copy this file to .env and fill in your values

# Required: Your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: ElevenLabs API key for premium Jarvis Robot voice
# Get key at https://elevenlabs.io — 10,000 chars/month free
# Without this, browser's built-in TTS is used (works fine)
ELEVENLABS_API_KEY=

# Optional: ElevenLabs Voice ID (default is the Jarvis Robot voice)
ELEVENLABS_VOICE_ID=WWtyH2oxeOp9yZwK8ERD

# Optional: Claude model (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Port (default: 3000)
PORT=3000
